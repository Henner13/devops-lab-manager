---
route:
  receiver: telegram

receivers:
  - name: telegram

    telegram_configs:
      - bot_token: "{{ TELEGRAM_BOT_TOKEN }}"
        chat_id: {{ TELEGRAM_CHAT_ID }}

       message: |
       🚨 DevOps Lab
       
       Alerta: {{ '{{ .CommonLabels.alertname }}' }}
       
       Estado: {{ '{{ .Status }}' }}
